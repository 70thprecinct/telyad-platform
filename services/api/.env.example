# Copy to services/api/.env and fill in. NEVER commit the real .env.

# --- Runtime ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
TELYAD_ENV_LABEL="Demonstration Environment"

# CORS: comma-separated origins for the four front-ends
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# --- Auth (required in production) ---
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Password assigned to seeded demo users. Choose your own; never hard-code in source.
DEMO_USER_PASSWORD=choose-a-demo-password

# --- Persistence ---
# Leave STORE unset for the zero-setup in-memory demo store.
# Set STORE=prisma to use the database below.
# STORE=prisma
DATABASE_URL="file:./dev.db"
# Production example (PostgreSQL):
# DATABASE_URL="postgresql://user:pass@host:5432/telyad?schema=public"
