# Copy to services/api/.env and fill in. NEVER commit the real .env.

# --- Runtime ---
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
APP_ENV=development            # development | staging | production
DEMO_MODE=on                   # on = demo behaviours enabled (demo:reset). Set off outside demos.
TELYAD_ENV_LABEL="Demonstration Environment"

# CORS: comma-separated allowed origins for the front-ends.
# ALLOWED_ORIGINS is preferred; CORS_ORIGINS is a fallback alias.
# Production example:
#   ALLOWED_ORIGINS=https://advertiser.telyad.com,https://mtn.telyad.com,https://admin.telyad.com
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# Public base URL of this API (used by the front-ends' NEXT_PUBLIC_API_URL).
API_BASE_URL=http://localhost:4000

# --- Auth (required in production) ---
# Use a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# Password assigned to seeded demo users. Choose your own; never hard-code in source.
DEMO_USER_PASSWORD=choose-a-demo-password

# --- Persistence ---
# The runtime uses the PERSISTENT Prisma store by DEFAULT (state survives
# restarts). DATABASE_URL is then required — the API fails fast if it is missing.
#   - Local demo:  SQLite file below (run `pnpm --filter @telyad/api db:reset`).
#   - Production:  PostgreSQL (set provider = "postgresql" in prisma/schema.prisma).
# Set STORE=memory ONLY for automated tests or an explicit non-persistent dev run.
# STORE=memory
DATABASE_URL="file:./prisma/dev.db"
# Production example (PostgreSQL):
# DATABASE_URL="postgresql://user:pass@host:5432/telyad?schema=public"
